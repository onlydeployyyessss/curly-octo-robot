# ============================================================
# PC MISSION — ENVIRONMENT VARIABLES
# Copy to .env and fill in. NEVER commit the real .env file.
# Secrets live on the server only — they are never bundled to
# the browser. The web app only sees NEXT_PUBLIC_/VITE_ flags.
# ============================================================

# ---------- Database (Railway/Neon/Vercel Postgres) ----------
DATABASE_URL=postgresql://pc:pc@localhost:5432/pc_mission

# ---------- Auth ----------
# 32+ random characters. Used to sign/encrypt session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: bootstrap admin (used by seed / first run). You can
# also create the first user from the login screen.
ADMIN_EMAIL=admin@pcmission.app
ADMIN_PASSWORD=change-me-on-first-login

# ---------- OpenRouter (optional AI message personalization) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://your-app.vercel.app

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your numeric Telegram chat id (get it from @userinfobot or /start)
TELEGRAM_CHAT_ID=
# Comma-separated extra user/chat ids allowed to control the bot
TELEGRAM_AUTHORIZED_IDS=

# ---------- Meta / Instagram (official Graph API + OAuth) ----------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-app.vercel.app/api/instagram/callback
META_GRAPH_VERSION=v21.0
# Verify token you set in the Meta App Dashboard webhook config
META_WEBHOOK_VERIFY=
META_WEBHOOK_SECRET=

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for OAuth links / CORS)
APP_URL=http://localhost:5173
# Secret protecting Vercel/Railway cron endpoints (Bearer token)
CRON_SECRET=another-long-random-string
# "true" runs the scheduler + Telegram long-polling inside the web
# process. On Vercel, leave false (Vercel Cron + webhooks are used).
# On Railway worker service, set true.
RUN_WORKER=false

# ---------- Frontend (Vite — safe to expose) ----------
# Base URL of the API. Same origin in production on Vercel.
VITE_API_URL=
# Set to 1 to run the dashboard against built-in demo data
# (no backend required). Useful for previewing the UI.
VITE_DEMO_MODE=0
